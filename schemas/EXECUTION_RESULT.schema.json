{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-workflow-v2/execution-result.schema.json",
  "title": "PWv2.1 Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "obligation_id",
    "freshness_fingerprint",
    "status",
    "subject",
    "changed_artifacts",
    "tests",
    "evidence",
    "readback",
    "blocker",
    "semantic_outcome"
  ],
  "properties": {
    "kind": {
      "const": "pwv2_execution_result"
    },
    "schema_version": {
      "const": 1
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "freshness_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "subject": {
      "$ref": "#/$defs/exact_ref"
    },
    "changed_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exact_ref"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "green",
              "red",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "status",
          "observation"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "failed",
              "not_applicable"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_outcome": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "exact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "blob"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
