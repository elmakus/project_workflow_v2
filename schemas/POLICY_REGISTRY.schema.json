{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-workflow-v2/policy-registry.schema.json",
  "title": "PWv2.1 mechanical policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "registry_version", "schema_version", "rules"],
  "properties": {
    "kind": {"const": "pwv2_mechanical_policy"},
    "registry_version": {"const": 1},
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "precedence", "predicate", "inputs", "outcome", "semantics"],
        "properties": {
          "id": {"type": "string", "pattern": "^PWV21-K[0-9]{3}$"},
          "precedence": {"type": "integer", "minimum": 1},
          "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"}
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disposition", "obligation", "owner_module"],
            "properties": {
              "disposition": {"enum": ["route", "stop", "recovery"]},
              "obligation": {"type": "string", "minLength": 1},
              "owner_module": {"type": "string", "pattern": "^workflow/.+\\.md$"}
            }
          },
          "semantics": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
